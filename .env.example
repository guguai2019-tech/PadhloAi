# GEMINI_API_KEY: Required for server-side Gemini AI API calls (never prefix with VITE_).
# Set this in AI Studio Secrets or Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Ollama Local Open-Source AI Configuration (Server-Side Only)
# Local development default: http://127.0.0.1:11434
# Note: Cloud deployments cannot reach your laptop localhost; use a reachable Ollama URL if deployed.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_API_KEY=""

# Admin Authentication Credentials (Server-Side Only)
ADMIN_ID=
ADMIN_PASSWORD=

# Optional Separate External Speech Generation (TTS) HTTP Endpoint (OpenAI-compatible /v1/audio/speech)
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=

# Optional Razorpay Payment Verification Credentials (Server-Side Only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
